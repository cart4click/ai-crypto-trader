# ================= AI Crypto Trader — configuration =================
# Copy this file to .env and fill in what you use. The app runs fine with
# NO keys at all (dry-run paper trading on real market data).

# ---------------- Binance ----------------
# Create at https://binance.com -> Profile -> API Management.
# SECURITY: enable only "Enable Reading" + "Enable Spot & Margin Trading".
# NEVER enable withdrawals. The app contains no withdrawal code at all.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = orders go to Binance Spot TESTNET (fake money). Set false for live.
BINANCE_TESTNET=true

# ---------------- AI (optional) ----------------
# Any OpenAI-compatible API works (OpenAI, Groq, DeepSeek, Ollama, ...).
# Without a key the app still forecasts with its built-in Monte-Carlo engine
# and scores news with a built-in sentiment lexicon.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------------- Telegram (optional but recommended) ----------------
# 1) Talk to @BotFather on Telegram -> /newbot -> copy the token here.
# 2) Send /start to YOUR bot, then put your numeric chat id below
#    (the app prints it when you message the bot; also /start replies it).
# Only these chat ids may receive signals / press Confirm. Nobody else can.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------------- App / safety rails ----------------
APP_HOST=127.0.0.1            # keep local; use 0.0.0.0 only with APP_TOKEN set
APP_PORT=8000
APP_TOKEN=                    # optional password for the web UI (LAN access)
APP_CORS_ORIGINS=             # comma-separated HTTPS frontend origins when hosted separately
DRY_RUN=true                  # true = paper trades (simulated fills). false = real orders
MAX_ORDER_USDT=100            # hard cap per order
MAX_DAILY_USDT=500            # hard cap of spend per calendar day
POLL_SECONDS=60               # how often the strategy engine checks prices
